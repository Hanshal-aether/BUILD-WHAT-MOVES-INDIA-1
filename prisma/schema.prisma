generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Citizen {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String?
  state     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
}

model Application {
  id              String   @id @default(uuid())
  citizenId       String
  citizen         Citizen  @relation(fields: [citizenId], references: [id])
  applicationType String
  status          String   @default("new")
  formData        String   @default("{}")
  state           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FairPriceShop {
  id        String   @id @default(uuid())
  name      String
  address   String
  state     String
  image     String   @default("/images/shops/shop-1.svg")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeSlots TimeSlot[]
}

model TimeSlot {
  id        String        @id @default(uuid())
  shopId    String
  shop      FairPriceShop @relation(fields: [shopId], references: [id])
  date      String
  startTime String
  endTime   String
  isBooked  Boolean       @default(false)
  createdAt DateTime      @default(now())
}
