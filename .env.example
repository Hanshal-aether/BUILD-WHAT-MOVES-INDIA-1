# ---- Database ----
# Free hosted Postgres from https://neon.tech (takes ~2 min, no credit card).
# Create a project there, copy the connection string it gives you, paste it here.
# It looks like: postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="paste-your-neon-connection-string-here"

# ---- OpenRouter AI Assistant ----
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY="your-openrouter-api-key-here"
